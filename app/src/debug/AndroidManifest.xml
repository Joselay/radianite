<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Exported so adb can reach it; DUMP is a permission the shell holds and other apps can't get. -->
        <receiver
            android:name=".sync.RunStoreSyncReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
